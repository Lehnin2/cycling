    <!-- http://github.com/silini/ontologies/2026/8/cycling#GoodTeam -->

    <owl:Class rdf:about="http://github.com/silini/ontologies/2026/8/cycling#GoodTeam">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
