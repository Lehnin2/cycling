    <!-- http://github.com/silini/ontologies/2026/8/cycling#Prologue -->

    <owl:Class rdf:about="http://github.com/silini/ontologies/2026/8/cycling#Prologue">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://github.com/silini/ontologies/2026/8/cycling##Stages"/>
                    <owl:Restriction>
