                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://github.com/silini/ontologies/2026/8/cycling#StageNumber"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
